#!/usr/bin/env bash
# Git hook before every `git push` (#8): a hard local check.
# 1. `make coverage-run`: all tests (ctest of the core with llvm-cov, flutter test --coverage of
#    the app, the tests of the tools) with coverage data.
# 2. `dart app/tool/coverage_check.dart`: every part reaches the minimum in tools/coverage-min
#    (C++ core and Dart logic, each on its own).
# If a test fails or a part is below the minimum, the push is aborted and the reason is named.
# Installation (once per clone): git config core.hooksPath tools/git-hooks
# Skip in an emergency: git push --no-verify
set -uo pipefail

ZERO="0000000000000000000000000000000000000000"
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1

# Only deleting remote branches: nothing to check.
push=0
while read -r _local_ref local_sha _remote_ref _remote_sha; do
  [ "$local_sha" = "$ZERO" ] || push=1
done
[ "$push" -eq 1 ] || exit 0

min="$(cat tools/coverage-min 2>/dev/null)"
if [ -z "$min" ]; then
  echo "pre-push: tools/coverage-min is missing. Push aborted."
  exit 1
fi

log="${TMPDIR:-/tmp}/woodshed-pre-push.log"
echo "pre-push: running all tests with coverage (make coverage-run), log: $log"
if ! make coverage-run >"$log" 2>&1; then
  tail -30 "$log"
  echo ""
  echo "pre-push: a test failed (see above and $log). Push aborted."
  exit 1
fi

echo "pre-push: checking coverage per part (minimum $min %)"
dart app/tool/coverage_check.dart --root "$root"
status=$?
if [ "$status" -eq 1 ]; then
  echo ""
  echo "pre-push: a part is below the minimum of $min % (see above). Push aborted."
  exit 1
elif [ "$status" -ne 0 ]; then
  echo ""
  echo "pre-push: coverage could not be checked (exit code $status). Push aborted."
  exit 1
fi

echo "pre-push: all tests green, every part reaches $min %. Pushing."
exit 0
