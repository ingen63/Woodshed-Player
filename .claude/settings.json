{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-commit.sh",
            "timeout": 1800
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(xcodebuild -project WoodshedPlayer.xcodeproj:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(python3 .claude/skills/clean-up/clean_up.py runs)",
      "Bash(python3 .claude/skills/clean-up/clean_up.py local)",
      "Bash(cmake -S core:*)",
      "Bash(cmake --build core/build:*)",
      "Bash(ctest --test-dir core/build:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter build:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(tools/hoervergleich.sh:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
