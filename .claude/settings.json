{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/after-commit.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(xcodebuild -project WoodshedPlayer.xcodeproj:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(tools/issue-id.sh sync)",
      "Bash(python3 .claude/skills/clean-up/clean_up.py runs)",
      "Bash(python3 .claude/skills/clean-up/clean_up.py local)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  }
}
