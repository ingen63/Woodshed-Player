# #9/AK7: every WP_API function declared in wp_core.h is called in at least one reference case
# (tests/reference_tests.cpp). A new function without a case fails this test.
# cmake -DHEADER=<wp_core.h> -DCASES=<reference_tests.cpp> -P reference_api_coverage.cmake
file(READ "${HEADER}" header)
file(READ "${CASES}" cases)
string(REGEX MATCHALL "WP_API[^;(]*[ *](wp_[a-z0-9_]+)\\(" decls "${header}")
set(missing)
set(count 0)
foreach(decl IN LISTS decls)
  string(REGEX REPLACE ".*[ *](wp_[a-z0-9_]+)\\($" "\\1" name "${decl}")
  math(EXPR count "${count} + 1")
  string(REGEX MATCH "[^a-z0-9_]${name}\\(" used "${cases}")
  if(NOT used)
    list(APPEND missing ${name})
  endif()
endforeach()
if(count LESS 30)
  message(FATAL_ERROR "only ${count} WP_API functions found in ${HEADER}; parser broken?")
endif()
if(missing)
  list(JOIN missing ", " text)
  message(FATAL_ERROR "WP_API functions without a reference case (#9/AK7): ${text}")
endif()
message(STATUS "all ${count} WP_API functions of wp_core.h have a reference case")
